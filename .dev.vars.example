# Copy to .dev.vars and fill in. Never commit .dev.vars.

# You.com Search API (https://you.com/platform), sent as X-API-Key
YOU_API_KEY=

# Clonvo gateway key (sk-cv-v1-…), OpenAI-compatible
CLONVO_API_KEY=

# Daytona API key (https://app.daytona.io), sandboxes for the fix loop
DAYTONA_API_KEY=

# GitHub fine-grained PAT, scoped to the demo repos only.
# Repository permissions: Contents (read & write), Pull requests (read & write), Actions (read), Metadata (read)
GITHUB_TOKEN=

# Optional: OpenCrawl agent token (`opencrawl token create --name firebreak --env-file .dev.vars`).
# Runs read and post notes on the OpenCrawl board and search agent history before repairing; Codex gets it over MCP.
OPENCRAWL_TOKEN=
# Optional: Codex sign-in, the whole of ~/.codex/auth.json from a ChatGPT login (`codex login`):
#   wrangler secret put CODEX_AUTH_JSON < ~/.codex/auth.json
# When set, Codex runs in the sandbox as the repair agent, with Clonvo as the fallback if it fails. Project code in
# the sandbox can read it while Codex runs. If a sandbox refreshes the login, your local Codex may need `codex login`;
# if your local Codex refreshes first, runs fall back to Clonvo until you put the secret again.
CODEX_AUTH_JSON=
