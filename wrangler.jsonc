{
  "$schema": "node_modules/wrangler/config-schema.json",
  // One Worker serves everything: the React app (static assets) and the API under /api/*.
  "name": "firebreak",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-10-12",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },

  "assets": {
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },

  // Non-secret configuration. Secrets go in .dev.vars locally and `wrangler secret put` in production:
  //   YOU_API_KEY, CLONVO_API_KEY, DAYTONA_API_KEY, GITHUB_TOKEN
  "vars": {
    "CLONVO_BASE_URL": "https://api.clonvo.com/v1",
    "DAYTONA_API_URL": "https://app.daytona.io/api",
    // General Daytona snapshot for fix sandboxes. The default (1 vCPU, 1 GiB) runs out of memory on production builds.
    "DAYTONA_SNAPSHOT": "daytona-medium",
    "FIX_MODEL": "anthropic/claude-sonnet-5-5",
    "EXTRACT_MODEL": "anthropic/claude-haiku-5-5"
  },

  // Repos, dependencies, incidents, exposures and fix-run summaries.
  //   wrangler d1 create firebreak   → paste the id below before the first deploy
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "firebreak",
      "database_id": "5fd4549a-f441-49cb-9f1b-de2e9653a899",
      "migrations_dir": "migrations"
    }
  ],

  // One FixRun per hotfix attempt: runs the sandbox loop on alarms and streams its log to the UI over WebSockets.
  "durable_objects": {
    "bindings": [{ "name": "FIX_RUN", "class_name": "FixRun" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["FixRun"] }],

  // Watcher: OSV + You.com news every 10 minutes (the UI also has "Check now").
  "triggers": { "crons": ["*/10 * * * *"] }
}
